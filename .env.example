# comms-graph — local config
PORT=3015
SERVICE_NAME=comms-graph
LOG_LEVEL=info
DEBUG_MODE=false

# Personality Service (mood, emotion, traits, behavioral guidance)
PERSONALITY_SERVICE_PORT=3012

# User Memory Service (quick profile/fact lookup)
MEMORY_SERVICE_PORT=3001
MCP_USER_MEMORY_API_KEY=

# Conversation Service
MCP_CONVERSATION_PORT=3004
MCP_CONVERSATION_API_KEY=

# Voice Service
MCP_VOICE_PORT=3006

# StateGraph backend (for handoffs)
STATEGRAPH_WS_URL=ws://localhost:4000/ws/stream
STATEGRAPH_API_KEY=test-api-key-123
THINKDROP_MAIN_PORT=3010

# Translation
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,zh,es,fr,pt,ar,ja,ko,hi,de,it,ru
AUTO_TRANSLATE=true

# LLM Providers (same chain as voice-service)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Task journal persistence
TASK_JOURNAL_PATH=~/.thinkdrop/task-journal.json

# Agent lock TTL (ms) — force-release lock if no progress update in this window
AGENT_LOCK_TTL_MS=600000
